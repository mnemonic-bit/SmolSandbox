# Smolfile — Dev tools base image for smolvm (smol-machines/smolvm)
# One declarative microVM: Debian 12 slim + Node 22 + Python 3 + .NET 8 SDK,
# OpenAI Codex CLI, Matt Pocock's grill-me/grilling skills,
# DeusData's codebase-memory-mcp, Podman + Buildah for nested containers,
# and Playwright + per-stack dev/debug tooling for live web-app testing.
#
# This is the build input for build-sandbox.sh. It intentionally has no host
# volumes: the resulting artifact is self-contained, and each derived machine
# gets its own mounts and network policy at `smolvm machine create --from`.
#
# Timezone: Europe/Berlin — see the preseed lines at the top of `init`.

image = "debian:bookworm-slim"
cpus = 4
memory = 8192            # MiB; elastic via virtio balloon. For installation this
                         # is a good starting point
storage = 20             # GiB; also holds nested Podman/Buildah layers.
net = true               # required for the egress allowlist below
workdir = "/workspace/myrepo"

[network]
# Everything the guest (and any container inside it) can ever reach.
# Nested containers NAT through the guest's network stack, so they inherit
# this allowlist too. Hosts marked "provisioning" are only needed by the init
# commands; drop them after the first `machine create` for a tighter policy.
#
# Note on Playwright: it ADVERTISES downloads from cdn.playwright.dev, but
# Chromium ("Chrome for Testing") builds are actually served from
# storage.googleapis.com, and FFmpeg & friends are tried first from
# playwright.download.prss.microsoft.com (fallback mirror: cdn.playwright.dev).
# All three must be allowed or you get ENOTFOUND (non-fatal for mirrored
# artifacts, fatal when there is no fallback).
allow_hosts = [
  "api.openai.com",                # Codex model access (API-key auth)
  "auth.openai.com",               # ChatGPT subscription sign-in (OAuth flow)
  "chatgpt.com",                   # ChatGPT backend (subscription-based Codex)
  "api.nuget.org",                 # NuGet — dotnet restore + global tools
  "globalcdn.nuget.org",           # NuGet package payload CDN
  "registry.npmjs.org",            # npm
  "pypi.org",                      # pip index
  "files.pythonhosted.org",        # pip wheels
  "registry-1.docker.io",          # Docker Hub — podman pull / buildah
  "auth.docker.io",                # Docker Hub auth
  "production.cloudflare.docker.com", # Docker Hub layer CDN
  "production.cloudfront.docker.com", # Docker Hub layer CDN (alternate)
  "ghcr.io",                       # GitHub Container Registry API + auth
  "pkg-containers.githubusercontent.com", # GitHub Container Registry layers
  "mcr.microsoft.com",             # Microsoft artifacts (SQL Server container, etc.)
  "dot.net",                       # .NET install script (provisioning)
  "aka.ms",                        # .NET SDK release resolution (provisioning)
  "builds.dotnet.microsoft.com",   # .NET SDK payloads (provisioning)
  "ci.dot.net",                     # .NET SDK payload fallback (provisioning)
  "cdn.playwright.dev",            # Playwright browser downloads (provisioning)
  "storage.googleapis.com",        # Playwright Chrome-for-Testing builds (provisioning)
  "playwright.download.prss.microsoft.com", # Playwright primary mirror (provisioning)
  "github.com",                    # skills + codebase-memory-mcp (provisioning)
  "api.github.com",                # release metadata / repo lookups (provisioning)
  "raw.githubusercontent.com",     # setup scripts (provisioning)
  "release-assets.githubusercontent.com", # GitHub release binaries (newer layout)
  "objects.githubusercontent.com", # GitHub release binaries (older redirect layout)
  "codeload.github.com",           # repo tarballs (provisioning)
  "deb.debian.org",                # Debian apt + security updates (provisioning)
  "deb.nodesource.com",            # Node 22 (provisioning)
  # "playwright.azureedge.net",    # legacy Playwright CDN, older versions
  # "quay.io",                     # add if you pull from Quay
]

# Optional: forward your HOST ssh-agent into the guest so `git pull/push`
# over SSH works without copying private keys into the VM — the hypervisor
# forwards the agent connection, keys never enter the guest.
# [auth]
# ssh_agent = true

[dev]
init = [
  # --- Unattended apt: preseed tzdata answers BEFORE anything touches apt ---
  # This is what stops the "Geographic area / city" dialog. For a different
  # timezone, change Areas and Zones/<Area> (e.g. America + New_York).
  "printf 'tzdata tzdata/Areas select Europe\\ntzdata tzdata/Zones/Europe select Berlin\\n' | debconf-set-selections",

  # Toolchains: Python 3, git, ripgrep, Podman + Buildah, Docker-compatible
  # command aliases, and extras. .NET 8 is installed below.
  # DEBIAN_FRONTEND=noninteractive suppresses ALL debconf dialogs (tzdata,
  # keyboard-configuration, console-setup, ...), not just tzdata.
  "DEBIAN_FRONTEND=noninteractive apt-get update",
  "DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends bash ca-certificates coreutils curl git grep gzip mawk tar openssh-client build-essential pkg-config ripgrep unzip jq sqlite3 httpie pipx python3 python3-pip python3-venv tzdata libgssapi-krb5-2 libicu72 libssl3 zlib1g podman podman-docker buildah",

  # Belt and suspenders: pin the timezone files explicitly and re-apply tzdata
  # config non-interactively (correct even if tzdata was already installed in
  # the base image before the preseed ran)
  "ln -sf /usr/share/zoneinfo/Europe/Berlin /etc/localtime && printf 'Europe/Berlin\\n' > /etc/timezone && dpkg-reconfigure -f noninteractive tzdata",

  # Microsoft's Debian feed publishes .NET 8 for x64 only. The official
  # installer auto-detects x64/Arm64 so the SmolVM stays host-portable.
  "curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && bash /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet --no-path && ln -sf /usr/share/dotnet/dotnet /usr/local/bin/dotnet && rm -f /tmp/dotnet-install.sh",

  # --- Git: the virtiofs-mounted /workspace/myrepo carries HOST UIDs, which
  # differ from the guest's root — git >= 2.35.2 then refuses to operate
  # ("detected dubious ownership", the CVE-2022-24765 check). Explicitly
  # trust the repo path; the '*' entry also covers nested repos, submodules,
  # and anything Codex clones to /tmp — same tradeoff CI containers make,
  # acceptable because the disposable microVM IS the security boundary.
  "git config --global --add safe.directory /workspace/myrepo",
  "git config --global --add safe.directory '*'",
  "git config --global init.defaultBranch main",
  # Optional: give Codex a git identity for commits it creates. Personalize,
  # or drop these lines and set GIT_AUTHOR_NAME/GIT_AUTHOR_EMAIL etc. via
  # [secrets] from_env instead.
  # "git config --global user.name 'Codex Sandbox'",
  # "git config --global user.email 'codex@sandbox.local'",

  # Podman/Buildah storage must NOT live on the rootfs (overlay2 cannot nest
  # on the machine's root overlay). Point the graph at the ext4 storage disk,
  # same pattern smol machines uses for docker-in-a-machine.
  # IMPORTANT: graphroot/runroot/driver must ALL be nested under the
  # [storage] table — containers-storage.conf(5) allows no bare top-level
  # options. (This was the "runroot must be set" bug.)
  "mkdir -p /storage/containers && printf '[storage]\\ndriver = \"overlay\"\\ngraphroot = \"/storage/containers/storage\"\\nrunroot = \"/run/containers/storage\"\\n' > /etc/containers/storage.conf",

  # Node 22 from NodeSource (Debian's own nodejs is too old for Codex CLI);
  # the setup script runs apt itself, so the env var must be exported into it
  "curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/node-setup.sh && DEBIAN_FRONTEND=noninteractive bash /tmp/node-setup.sh && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs",

  # OpenAI Codex CLI (installed BEFORE codebase-memory-mcp so its `install`
  # subcommand can detect the Codex CLI and register itself with it)
  "npm install -g @openai/codex@0.155.1",

  # Sol with high reasoning is the machine default; the footer exposes token,
  # context, and rate-limit headroom. Full permissions are appropriate inside
  # the microVM boundary. The final init step snapshots this prepared Codex
  # home so launchers can seed the persistent host-mounted state directory on
  # first use.
  "mkdir -p /root/.codex && printf 'model = \"gpt-5.6-sol\"\\nmodel_reasoning_effort = \"high\"\\nmodel_context_window = 1000000\\nmodel_auto_compact_token_limit = 900000\\nsandbox_mode = \"danger-full-access\"\\napproval_policy = \"never\"\\n\\n[tui]\\nstatus_line = [\\n  \"model-with-reasoning\",\\n  \"current-dir\",\\n  \"context-remaining\",\\n  \"used-tokens\",\\n  \"five-hour-limit\",\\n  \"weekly-limit\",\\n]\\nstatus_line_use_colors = true\\n\\n[projects.\"/workspace/myrepo\"]\\ntrust_level = \"trusted\"\\n' > /root/.codex/config.toml",

  # Matt Pocock's grill-me + grilling skills — global install for Codex
  # (lands in /root/.codex/skills), non-interactive
  "npx -y skills@1.7.0 add mattpocock/skills --skill=grill-me --skill=grilling --agent codex --global --yes",

  # DeusData codebase-memory-mcp. The maintained installer selects the fully
  # static Linux "-portable" artifact; the legacy scripts/setup.sh selected a
  # binary requiring glibc 2.38 and GLIBCXX_3.4.32, which Debian 12 lacks.
  # Pin both installer and release, verify the upstream checksum, and configure
  # only the already-installed Codex client without an interactive prompt.
  "curl -fsSL https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/v0.11.0/install.sh | CBM_DOWNLOAD_URL=https://github.com/DeusData/codebase-memory-mcp/releases/download/v0.11.0 bash -s -- --clients=codex",
  # Keep an explicit runtime smoke test at the provisioning boundary. The
  # installer already runs this check before and after activating the binary.
  "/root/.local/bin/codebase-memory-mcp --version",
  "ln -sf /root/.local/bin/codebase-memory-mcp /usr/local/bin/",
  # Deterministic alternative if agent detection ever misses Codex — writes
  # the same config entry via Codex itself instead of relying on detection:
  # "codex mcp add codebase-memory-mcp -- /root/.local/bin/codebase-memory-mcp",

  # --- .NET web-dev tooling (dotnet watch / dotnet run ship with the SDK) ---
  # dotnet-ef: EF Core migrations for the CLI; dotnet-dump/-trace/-counters:
  # post-mortem and live diagnostics without a Visual Studio attach
  "dotnet tool install -g dotnet-ef --version 8.0.31",
  "dotnet tool install -g dotnet-dump --version 8.0.547301",
  "dotnet tool install -g dotnet-trace --version 8.0.547301",
  "dotnet tool install -g dotnet-counters --version 8.0.547301",
  "ln -sf /root/.dotnet/tools/* /usr/local/bin/",

  # --- Python tooling: uv (fast venv/deps), pytest, debugpy (DAP debugger),
  # ruff (lint/format) — installed as isolated CLI apps via pipx
  "pipx install uv==0.12.17",
  "pipx install pytest==9.1.1",
  "pipx install debugpy==1.8.22",
  "pipx install ruff==0.16.8",
  "ln -sf /root/.local/bin/* /usr/local/bin/",

  # --- Node helpers: tsx (run/watch TS directly), vitest; node --inspect
  # and node --watch are built into Node 22
  "npm install -g tsx@4.23.15 vitest@5.0.1",

  # --- Playwright: npm stack + Chromium with all OS dependencies ---
  # --with-deps runs apt-get internally, so DEBIAN_FRONTEND is exported too.
  # Chromium is a "Chrome for Testing" build (cdn.playwright.dev ->
  # storage.googleapis.com); FFmpeg is tried first from
  # playwright.download.prss.microsoft.com and falls back to cdn.playwright.dev.
  # Browsers land in /root/.cache/ms-playwright, versioned per package, so
  # the Python binding below coexists there with its own build.
  "npm install -g playwright@1.63.0 @playwright/test@1.63.0",
  "DEBIAN_FRONTEND=noninteractive playwright install --with-deps chromium",

  # --- Playwright: Python binding (same browser cache, invoked as a module
  # to avoid clashing with the npm CLI binary) ---
  "python3 -m pip install --break-system-packages playwright==1.63.0",
  "python3 -m playwright install chromium",

  # Smoke test: pull and run a tiny container through podman-docker's Docker
  # command to prove both nested Podman and Docker CLI compatibility work.
  "docker run --rm docker.io/library/alpine echo nested-podman-via-docker-ok",

  # Derived machines mount persistent state over /root/.codex. Preserve the
  # prepared defaults elsewhere in the artifact so start-login/start-codex
  # can copy missing config, skills, and MCP registration into that mount.
  "mkdir -p /workspace/myrepo /opt/codex-home && cp -a /root/.codex/. /opt/codex-home/ && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/node-setup.sh"
]
