# Smolfile — Codex sandbox for smolvm (smol-machines/smolvm)
# One declarative microVM: Ubuntu 24.04 + Node 22 + Python 3 + .NET 8 SDK,
# OpenAI Codex CLI, Matt Pocock's grill-me/grilling skills,
# DeusData's codebase-memory-mcp, Podman + Buildah for nested containers,
# and Playwright + per-stack dev/debug tooling for live web-app testing.
#
# Create from your repo root so "./" mounts the right project:
#   smolvm machine create --name codex-sandbox --smolfile ./Smolfile --storage 20
# The repo is mounted at /workspace/myrepo — a directory INSIDE /workspace,
# not the mount root itself, because codebase-memory-mcp treats mount roots
# as "too broad" repository roots and refuses to index them.
#
# NOTE: the Smolfile is read ONLY at `machine create`. Editing it has no
# effect on an existing machine — apply changes with `machine update`
# (stopped, where supported) or delete + re-create (safe: Codex state lives
# on the .smolvm/codex-home host mount).
#
# NOTE: add `.smolvm/` to your repo's .gitignore — it holds Codex session
# state that must not be committed.
#
# Timezone: Europe/Berlin — see the preseed lines at the top of `init`.
# API key: [secrets] from_env resolves the HOST environment variable
# OPENAI_API_KEY at every `machine start` — export it before starting.
# (Not needed if you sign in with your ChatGPT subscription instead —
# see the auth.openai.com / chatgpt.com entries in the allowlist.)

image = "ubuntu:24.04"
cpus = 4
memory = 12288           # MiB; elastic via virtio balloon. Headless Chromium
                          # plus builds plus the app itself live in RAM together.
net = true               # required for the egress allowlist below
workdir = "/workspace/myrepo"

[network]
# Everything the guest (and any container inside it) can ever reach.
# Nested containers NAT through the guest's network stack, so they inherit
# this allowlist too. Hosts marked "provisioning" are only needed by the init
# commands; drop them after the first `machine create` for a tighter policy.
#
# Note on Playwright: it ADVERTISES downloads from cdn.playwright.dev, but
# Chromium ("Chrome for Testing") builds are actually served from
# storage.googleapis.com, and FFmpeg & friends are tried first from
# playwright.download.prss.microsoft.com (fallback mirror: cdn.playwright.dev).
# All three must be allowed or you get ENOTFOUND (non-fatal for mirrored
# artifacts, fatal when there is no fallback).
allow_hosts = [
  "api.openai.com",                # Codex model access (API-key auth)
  "auth.openai.com",               # ChatGPT subscription sign-in (OAuth flow)
  "chatgpt.com",                   # ChatGPT backend (subscription-based Codex)
  "api.nuget.org",                 # NuGet — dotnet restore + global tools
  "registry.npmjs.org",            # npm
  "deb.nodesource.com",            # Node 22 (provisioning)
  "pypi.org",                      # pip index
  "files.pythonhosted.org",        # pip wheels
  "registry-1.docker.io",          # Docker Hub — podman pull / buildah
  "auth.docker.io",                # Docker Hub auth
  "production.cloudflare.docker.com", # Docker Hub layer CDN
  # "ghcr.io",                     # add if you pull/push GitHub Container Registry
  # "quay.io",                     # add if you pull from Quay
]

# Optional: forward your HOST ssh-agent into the guest so `git pull/push`
# over SSH works without copying private keys into the VM — the hypervisor
# forwards the agent connection, keys never enter the guest.
# [auth]
# ssh_agent = true

[dev]
# Host paths exposed to the guest:
#  1. The repo you created the machine from, mounted at /workspace/myrepo.
#     It is deliberately NOT the mount root: codebase-memory-mcp sees the
#     root of a shared mount as "the root of all repos" (a container-style
#     workspace) and refuses to index it — nesting it one level down makes
#     it look like the normal, single-project repo it is. The ext4 storage
#     disk stays at /storage for container layers.
#  2. Codex persistent state, mounted at the DEFAULT CODEX_HOME location
#     (/root/.codex): config.toml, auth.json, history.jsonl, the state DB,
#     skills/, and sessions/ (per-session rollout files that make
#     `codex resume` work across machine rebuilds).
#
# It is mounted at /root/.codex on purpose instead of setting CODEX_HOME to
# a custom path: some tools hardcode ~/.codex (e.g. codebase-memory-mcp's
# installer writes the MCP server entry into ~/.codex/config.toml), and the
# default path needs no env plumbing during init or exec. If you prefer an
# explicit CODEX_HOME=/codex-home, change the guest path below AND prefix
# every init command and exec that touches Codex with CODEX_HOME=/codex-home.
volumes = [
  ".:/workspace/myrepo",
  "~/.codex:/root/.codex",
]

# Host:guest port forwards, symmetric so direction never matters. Codex tests
# against guest-localhost directly (no forward needed); these let YOU open the
# running app in your host browser. 3000 Next/React, 5000 ASP.NET default,
# 5173 Vite, 8000 Django/FastAPI/uvicorn, 8080 generic.
#ports = ["3000:3000", "5000:5000", "5173:5173", "8000:8000", "8080:8080"]

#init = [
#  codex login --device-auth
#]

