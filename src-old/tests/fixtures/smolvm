#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >> "$SMOLVM_TEST_LOG"

emit_public_inventory() {
  python3 -c '
import json
import sys

inventory = json.load(sys.stdin)
for machine in inventory:
    concrete = machine.pop("_test_ports", None)
    if concrete is not None:
        machine["ports"] = len(concrete)
    else:
        machine.setdefault("ports", 0)
    machine.setdefault("created_at", 1)
json.dump(inventory, sys.stdout, separators=(",", ":"))
sys.stdout.write("\n")
'
}

if [ "${1:-}" = machine ] && [ "${2:-}" = start ] && \
   [ "${SMOLVM_TEST_START_FAIL:-}" = 1 ]; then
  echo 'simulated machine start failure' >&2
  exit 75
fi

case "$*" in
  "--version")
    printf '%s\n' "${SMOLVM_TEST_VERSION:-smolvm test 1.0.0}"
    exit 0
    ;;
  "machine update --help")
    if [ "${SMOLVM_TEST_INCOMPATIBLE_UPDATE:-}" = 1 ]; then
      printf '%s\n' 'Usage: smolvm machine update --name NAME'
    else
      printf '%s\n' \
        'Usage: smolvm machine update --name NAME' \
        '  --port PORT' \
        '  --remove-port PORT'
    fi
    exit 0
    ;;
  "machine ls --json")
    inventory_call=1
    if [ -n "${SMOLVM_TEST_INVENTORY_SEQUENCE_FILE:-}" ]; then
      inventory_count_file="${SMOLVM_TEST_INVENTORY_COUNT_FILE:-$SMOLVM_TEST_INVENTORY_SEQUENCE_FILE.count}"
      if [ -s "$inventory_count_file" ]; then
        inventory_call=$(( $(sed -n '1p' "$inventory_count_file") + 1 ))
      fi
      printf '%s\n' "$inventory_call" > "$inventory_count_file"
    fi
    if [ "${SMOLVM_TEST_INVENTORY_FAIL:-}" = 1 ] || \
       [ "${SMOLVM_TEST_INVENTORY_FAIL_AT:-}" = "$inventory_call" ]; then
      echo 'simulated inventory failure' >&2
      exit 70
    elif [ -n "${SMOLVM_TEST_INVENTORY_SEQUENCE_FILE:-}" ]; then
      response="$(sed -n "${inventory_call}p" "$SMOLVM_TEST_INVENTORY_SEQUENCE_FILE")"
      if [ -z "$response" ]; then
        echo "missing simulated inventory response $inventory_call" >&2
        exit 70
      fi
      printf '%s\n' "$response" | emit_public_inventory
    elif [ -n "${SMOLVM_TEST_INVENTORY_FILE:-}" ]; then
      emit_public_inventory < "$SMOLVM_TEST_INVENTORY_FILE"
    elif [ -n "${SMOLVM_TEST_INVENTORY:-}" ]; then
      printf '%s\n' "$SMOLVM_TEST_INVENTORY" | emit_public_inventory
    else
      printf '%s\n' "${SMOLVM_TEST_MACHINES:-}" | awk '
        BEGIN { printf "["; separator = "" }
        NF { printf "%s{\"name\":\"%s\",\"state\":\"stopped\",\"labels\":{}}", separator, $0; separator = "," }
        END { print "]" }
      ' | emit_public_inventory
    fi
    exit 0
    ;;
  "machine status --name test-machine" | \
  "machine start --name test-machine" | \
  "machine stop --name test-machine")
    exit 0
    ;;
  *"/opt/codex-home"*)
    if [ "${SMOLVM_TEST_SEED_FAIL:-}" = 1 ]; then
      echo "cp: warning: simulated seed failure" >&2
      exit 1
    fi
    if [[ "$*" == *"cp -a"* ]]; then
      echo "cp: preserving permissions: Operation not permitted" >&2
      exit 1
    fi
    exit 0
    ;;
  *" -- codex --no-daemon --help")
    exit 0
    ;;
esac

if [ "${1:-}" = machine ] && [ "${2:-}" = create ] && \
   [ "${SMOLVM_TEST_CREATE_FAIL:-}" = 1 ]; then
  echo 'simulated machine create failure' >&2
  exit 71
fi

if [ "${1:-}" = machine ] && [ "${2:-}" = stop ] && \
   { [ "${SMOLVM_TEST_STOP_FAIL:-}" = 1 ] || \
     { [ -n "${SMOLVM_TEST_STOP_FAIL_NAME:-}" ] && [[ "$*" == *"--name $SMOLVM_TEST_STOP_FAIL_NAME"* ]]; }; }
then
  echo 'simulated machine stop failure' >&2
  exit 72
fi

if [ "${1:-}" = machine ] && [ "${2:-}" = delete ] && \
   { [ "${SMOLVM_TEST_DELETE_FAIL:-}" = 1 ] || \
     { [ -n "${SMOLVM_TEST_DELETE_FAIL_NAME:-}" ] && [[ "$*" == *"--name $SMOLVM_TEST_DELETE_FAIL_NAME"* ]]; }; }
then
  echo 'simulated machine delete failure' >&2
  exit 73
fi

if [ "${1:-}" = machine ] && [ "${2:-}" = create ] && \
   [ "${SMOLVM_TEST_ALLOW_CREATE:-}" = 1 ]; then
  name=""
  labels=()
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        name="$2"
        shift 2
        ;;
      --label)
        labels+=("$2")
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done
  if [ -n "${SMOLVM_TEST_INVENTORY_FILE:-}" ]; then
    python3 - "$SMOLVM_TEST_INVENTORY_FILE" "$name" "${labels[@]}" <<'PY'
import json
import os
import sys
import tempfile

path, name, *raw_labels = sys.argv[1:]
labels = dict(label.split("=", 1) for label in raw_labels)
with open(path, encoding="utf-8") as inventory_file:
    inventory = json.load(inventory_file)
if not any(machine["name"] == name for machine in inventory):
    inventory.append({
        "name": name,
        "state": "created",
        "labels": labels,
        "ports": 0,
        "_test_ports": [],
        "created_at": int(os.environ.get("SMOLVM_TEST_CREATED_AT", "1")),
    })
fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix="inventory.")
with os.fdopen(fd, "w", encoding="utf-8") as inventory_file:
    json.dump(inventory, inventory_file)
os.replace(temporary, path)
PY
  fi
  exit 0
fi

if [ "${1:-}" = machine ] && [ "${2:-}" = update ] && \
   [ "${SMOLVM_TEST_ALLOW_LIFECYCLE:-}" = 1 ]; then
  if [ "${SMOLVM_TEST_UPDATE_FAIL:-}" = 1 ]; then
    echo 'simulated machine update failure' >&2
    exit 75
  fi
  name=""
  additions=()
  removals=()
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        name="$2"
        shift 2
        ;;
      --port)
        additions+=("$2")
        shift 2
        ;;
      --remove-port)
        removals+=("$2")
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done
  if [ -n "${SMOLVM_TEST_INVENTORY_FILE:-}" ]; then
    python3 - "$SMOLVM_TEST_INVENTORY_FILE" "$name" \
      "${#removals[@]}" "${removals[@]}" "${additions[@]}" <<'PY'
import json
import os
import sys
import tempfile

path, name, raw_remove_count, *values = sys.argv[1:]
remove_count = int(raw_remove_count)
removals = values[:remove_count]
additions = values[remove_count:]

def host_port(spec: str) -> int:
    return int(spec.split(":", 1)[0])

with open(path, encoding="utf-8") as inventory_file:
    inventory = json.load(inventory_file)
matches = [machine for machine in inventory if machine.get("name") == name]
if len(matches) != 1:
    raise SystemExit("machine update target is missing")
machine = matches[0]
if str(machine.get("state", "")).casefold() not in {"created", "stopped"}:
    raise SystemExit("machine update target is not stopped")
ports = set(machine.get("_test_ports", []))
for spec in removals:
    ports.discard(host_port(spec))
for spec in additions:
    ports.add(host_port(spec))
machine["_test_ports"] = sorted(ports)
machine["ports"] = len(ports)
if os.environ.get("SMOLVM_TEST_UPDATE_WRONG_COUNT") == "1":
    machine["_test_ports"] = sorted({*ports, 65535})
    machine["ports"] = len(machine["_test_ports"])
fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix="inventory.")
with os.fdopen(fd, "w", encoding="utf-8") as inventory_file:
    json.dump(inventory, inventory_file)
os.replace(temporary, path)
PY
  fi
  if [ "${SMOLVM_TEST_UPDATE_FAIL_AFTER:-}" = 1 ]; then
    echo 'simulated interruption after machine update' >&2
    exit 75
  fi
  exit 0
fi

if [ "${1:-}" = machine ] && [ "${2:-}" = exec ] && [[ "$*" == *" -- codex "* ]]; then
  exit 0
fi

if [ "${1:-}" = machine ] && { [ "${2:-}" = start ] || [ "${2:-}" = stop ]; } && \
   { [ "${SMOLVM_TEST_ALLOW_LIFECYCLE:-}" = 1 ] || [ "${SMOLVM_TEST_ALLOW_CLEANUP:-}" = 1 ]; }
then
  if [ -n "${SMOLVM_TEST_INVENTORY_FILE:-}" ]; then
    operation="$2"
    name=""
    shift 2
    while [ "$#" -gt 0 ]; do
      if [ "$1" = --name ]; then
        name="$2"
        break
      fi
      shift
    done
    python3 - "$SMOLVM_TEST_INVENTORY_FILE" "$name" "$operation" <<'PY'
import json
import os
import sys
import tempfile

path, name, operation = sys.argv[1:]
with open(path, encoding="utf-8") as inventory_file:
    inventory = json.load(inventory_file)
for machine in inventory:
    if machine["name"] == name:
        machine["state"] = "running" if operation == "start" else "stopped"
fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix="inventory.")
with os.fdopen(fd, "w", encoding="utf-8") as inventory_file:
    json.dump(inventory, inventory_file)
os.replace(temporary, path)
PY
  fi
  exit 0
fi

if [ "${1:-}" = machine ] && [ "${2:-}" = delete ] && \
   [ "${SMOLVM_TEST_ALLOW_CLEANUP:-}" = 1 ]; then
  if [ -n "${SMOLVM_TEST_INVENTORY_FILE:-}" ]; then
    name=""
    shift 2
    while [ "$#" -gt 0 ]; do
      if [ "$1" = --name ]; then
        name="$2"
        break
      fi
      shift
    done
    python3 - "$SMOLVM_TEST_INVENTORY_FILE" "$name" <<'PY'
import json
import os
import sys
import tempfile

path, name = sys.argv[1:]
with open(path, encoding="utf-8") as inventory_file:
    inventory = [machine for machine in json.load(inventory_file) if machine["name"] != name]
fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix="inventory.")
with os.fdopen(fd, "w", encoding="utf-8") as inventory_file:
    json.dump(inventory, inventory_file)
os.replace(temporary, path)
PY
  fi
  exit 0
fi

if [ "${1:-}" = pack ] && [ "${2:-}" = create ] && \
   [ "${SMOLVM_TEST_ALLOW_CREATE:-}" = 1 ]; then
  if [ "${SMOLVM_TEST_PACK_FAIL:-}" = 1 ]; then
    echo 'simulated pack failure' >&2
    exit 74
  fi
  output=""
  while [ "$#" -gt 0 ]; do
    if [ "$1" = -o ]; then
      output="$2"
      break
    fi
    shift
  done
  printf 'artifact\n' > "$output.smolmachine"
  exit 0
fi

echo "unexpected smolvm invocation: $*" >&2
exit 64
